# =============================================================================
# Нормализация переносов строк.
# =============================================================================

* text=auto eol=lf

*.php  text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.xml  text eol=lf
*.neon text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.html text eol=lf

# Бинарные файлы — не трогать.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.tar binary
*.gz binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# =============================================================================
# Исключения из релизного архива (git archive).
# Эти файлы остаются в репозитории, но не попадают в ZIP для сервера.
# =============================================================================

# Git и GitHub.
/.gitattributes    export-ignore
/.gitignore        export-ignore
/.github/          export-ignore

# Редактор.
/.editorconfig     export-ignore

# Composer (dev-зависимости).
/vendor/           export-ignore
/composer.json     export-ignore
/composer.lock     export-ignore

# Инструменты статического анализа.
/phpcs.xml         export-ignore
/phpstan.neon      export-ignore

# Документация репозитория.
/README.md         export-ignore
/LICENSE           export-ignore