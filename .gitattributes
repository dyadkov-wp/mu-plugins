# Нормализация переносов строк: всегда LF в репозитории.
* text=auto eol=lf

# Явно для текстовых файлов.
*.php  text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.xml  text eol=lf
*.neon text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.html text eol=lf

# Бинарные файлы — не трогать.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.tar binary
*.gz binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary